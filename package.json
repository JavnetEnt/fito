{
  "name": "fito",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:server\" \"npm:client\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0"
  }
}
